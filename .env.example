# Cloud Relational Database Connection URI (Neon DB / PostgreSQL / Supabase / Render / AWS RDS)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Example for Neon DB:
DATABASE_URL="postgresql://neondb_owner:npg_x123abc@ep-cool-lake-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Optional alias names also supported:
# POSTGRES_URL="postgresql://user:pass@host/dbname?sslmode=require"
# NEON_DB_URL="postgresql://user:pass@host/dbname?sslmode=require"
